# lab.conf.example — copy to lab.conf and edit (lab.conf is gitignored).
# Prefer this file for IFACE/PEER/DUT_IP/IBMVETH_KO/iperf knobs.
# Do not also pass those on the sudo line — CLI env wins and is easy to get wrong.
# One-shot knobs (T14_CYCLE, SKIP_HEAVY, …) may still go on the command line.
#
#   cp lab.conf.example lab.conf
#   sudo ./run_mq_all.sh
#
# Optional: LAB_CONF=/path/to/other.conf

# --- profile: mq (env9 private L2) ---
# Example sites: balco 192.168.1.x; ltcd51-lp19 192.168.100.2/3 (see README).
IFACE=env9
PEER=192.168.1.153
DUT_IP=192.168.1.133
IBMVETH_KO=/home/ming/ibmveth-build
EXTERNAL_IPERF=1

# Optional: kernel tree with Documentation/netlink/specs/netdev.yaml (t24).
# If unset, env.sh tries /lib/modules/$(uname -r)/{source,build} and common paths.
# KERNEL_SRC=/root/ming/linux

# Optional: fail preflight when uname -r does not match this git short SHA.
# EXPECT_KERNEL=81a8f2902bc3

# iperf (DUT servers + peer clients)
IPERF_PORT_FIRST=5201
IPERF_PORT_LAST=5216
IPERF_PARALLEL=4
IPERF_TIME=0
# 0 = run forever (needed for T14 full / run_mq_all heavy)

# Legacy adapters for run_all.sh, iface=peer, space separated. run_all
# runs the mq profile above, then run_legacy_all.sh on each of these.
# LEGACY="net0=10.48.36.153"

# --- profile: legacy (uncomment & comment mq block above) ---
# IFACE=net0
# PEER=10.48.36.153
# DUT_IP=10.48.36.133
# IBMVETH_KO=/home/ming/ibmveth-build
# EXTERNAL_IPERF=1
# IPERF_PORT_FIRST=5201
# IPERF_PORT_LAST=5204
# IPERF_PARALLEL=2
# IPERF_TIME=0
